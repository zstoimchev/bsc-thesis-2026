python - <<'PY'
import pandas as pd
from pathlib import Path

src = Path("data/parquets/realworld_botnet_balanced/realworld_cic_like_botnet_balanced.parquet")
out = Path("data/prepared/realworld_botnet_balanced_cic_100k.parquet")

df = pd.read_parquet(src)

sample = (
    df.groupby("label", group_keys=False)
      .apply(lambda x: x.sample(n=min(len(x), 50000), random_state=42))
      .sample(frac=1, random_state=42)
      .reset_index(drop=True)
)

out.parent.mkdir(parents=True, exist_ok=True)
sample.to_parquet(out, index=False)

print("Saved:", out)
print("Shape:", sample.shape)
print(sample["label"].value_counts())
